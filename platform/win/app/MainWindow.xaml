<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Fairlead.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
   
    Title="Fairlead">
        <Grid x:Name="Root" Background="{StaticResource BgBrush}" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" UseLayoutRounding="True" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape"/>
        </Grid.KeyboardAccelerators>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="{StaticResource SideBrush}" Padding="14,48,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
            <TextBox x:Name="Search" PlaceholderText="Search" Style="{StaticResource QuietBox}" Padding="32,8,10,8" TextChanged="SearchChanged">
                <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="#0AFFFFFF"/>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#12FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0AFFFFFF"/>
                </TextBox.Resources>
            </TextBox>
            <FontIcon Glyph="&#xE721;" FontSize="12" Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
            </Grid>
            <TextBlock Grid.Row="1" Text="TUNNELS" Margin="4,18,0,8" FontSize="10" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{StaticResource FaintBrush}"/>
            <ListView x:Name="TunnelList" Grid.Row="2" SelectionChanged="TunnelChosen" Background="Transparent" BorderThickness="0" Padding="0">
                    <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="UseSystemFocusVisuals" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1"/>
                                        </Grid.RenderTransform>
                                        <Border x:Name="Plate" CornerRadius="9" Background="Transparent"/>
                                        <ContentPresenter/>
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="PointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Target="Plate.Background" Value="#09FFFFFF"/>
                                                    </VisualState.Setters>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <VisualState.Setters>
                                                        <Setter Target="Plate.Background" Value="#14FFFFFF"/>
                                                    </VisualState.Setters>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.08"/>
                                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.08"/>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Target="Plate.Background" Value="#12FFFFFF"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="PointerOverSelected">
                                                    <VisualState.Setters>
                                                        <Setter Target="Plate.Background" Value="#18FFFFFF"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="PressedSelected">
                                                    <VisualState.Setters>
                                                        <Setter Target="Plate.Background" Value="#1CFFFFFF"/>
                                                    </VisualState.Setters>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.08"/>
                                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.08"/>
                                                    </Storyboard>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource PillButton}" Click="NewTunnel">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE710;" FontSize="12" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/>
                        <TextBlock Text="New" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PillButton}" Click="ImportTunnel">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B5;" FontSize="12" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/>
                        <TextBlock Text="Import" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1">
            <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" MaxWidth="460">
                <Ellipse Width="42" Height="42" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" HorizontalAlignment="Center"/>
                <TextBlock Text="No tunnels" FontSize="22" FontWeight="Medium" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Import a WireGuard or AmneziaWG config, or create a new one. You can drop a .conf file or an Amnezia share on the window." FontSize="13" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                <Button Content="Create" Style="{StaticResource ProminentButton}" HorizontalAlignment="Center" Click="NewTunnel" Margin="0,6,0,0"/>
            </StackPanel>
            <!-- Header / power / stats stay fixed; only policy+routes scroll. Border padding — Grid.Padding + composition Offset fought each other. -->
            <Border x:Name="Detail" Padding="34,48,34,20">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel x:Name="DetailHead" Spacing="22" Margin="0,0,0,22">
                    <Border x:Name="NoticeCard" Visibility="Collapsed" Background="#1A7CDBB6" CornerRadius="10" Padding="13">
                        <TextBlock x:Name="NoticeText" FontSize="14" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                    </Border>
                    <Border x:Name="Banner" Visibility="Collapsed" Background="#1AE15A45" CornerRadius="10" Padding="13">
                        <TextBlock x:Name="BannerText" FontSize="14" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                    </Border>
                    <Grid x:Name="HeaderBlock" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="HeaderMeta" Spacing="6">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="HeaderMetaY"/>
                            </StackPanel.RenderTransform>
                            <TextBlock x:Name="TitleText" FontSize="29" FontWeight="Medium" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="EndpointText" FontSize="14" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="AddressText" FontSize="13" FontFamily="Consolas" Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border x:Name="AwgBadge" Padding="10,4" VerticalAlignment="Center" Visibility="Collapsed" Background="#1F7CDBB6" CornerRadius="12" BorderBrush="#477CDBB6" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="AwgBadgeScale" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <TextBlock Text="AmneziaWG" FontSize="12" FontWeight="Medium" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" TextLineBounds="Tight"/>
                            </Border>
                            <Button Content="Edit" Style="{StaticResource PillButton}" Click="OpenEditor" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource IconButton}" Background="#0DFFFFFF" VerticalAlignment="Center">
                                <Button.Content>
                                    <TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button.Content>
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Export…" Click="ExportSelected"/>
                                        <MenuFlyoutItem Text="Delete" Click="AskDelete"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="PowerRow" Orientation="Horizontal" Spacing="30">
                        <StackPanel.RenderTransform>
                            <TranslateTransform/>
                        </StackPanel.RenderTransform>
                        <Button x:Name="Power" Width="96" Height="96" Padding="0" Background="#08FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0" CornerRadius="48" Click="TogglePower"
                                PointerPressed="PowerPressed" PointerReleased="PowerReleased" PointerCaptureLost="PowerReleased">
                            <Grid Width="96" Height="96">
                                <Ellipse x:Name="PowerRing" Width="96" Height="96" Stroke="{StaticResource LineBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                                <Ellipse x:Name="PowerSpin" Width="96" Height="96" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                         StrokeDashArray="70,220" StrokeDashCap="Round" Visibility="Collapsed" IsHitTestVisible="False"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="PowerSpinRotate"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <FontIcon x:Name="PowerIcon" Glyph="&#xE7E8;" FontSize="27" Foreground="{StaticResource MutedBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                        </Button>
                        <StackPanel VerticalAlignment="Center" Spacing="6">
                            <TextBlock x:Name="PhaseText" FontSize="23" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock x:Name="DetailText" FontSize="14" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="IfaceText" FontSize="13" FontFamily="Consolas" Foreground="{StaticResource FaintBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid x:Name="StatsRow" ColumnSpacing="11">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}" Grid.Column="0"><StackPanel><TextBlock Text="DOWN" Style="{StaticResource StatLabel}"/><TextBlock x:Name="DownText" Style="{StaticResource StatValue}"/></StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}" Grid.Column="1"><StackPanel><TextBlock Text="UP" Style="{StaticResource StatLabel}"/><TextBlock x:Name="UpText" Style="{StaticResource StatValue}"/></StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}" Grid.Column="2"><StackPanel><TextBlock Text="RECEIVED" Style="{StaticResource StatLabel}"/><TextBlock x:Name="RxText" Style="{StaticResource StatValue}"/></StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}" Grid.Column="3"><StackPanel><TextBlock Text="SENT" Style="{StaticResource StatLabel}"/><TextBlock x:Name="TxText" Style="{StaticResource StatValue}"/></StackPanel></Border>
                    </Grid>
                </StackPanel>
                <ScrollViewer x:Name="DetailScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" BringIntoViewOnFocusChange="False">
                    <Border x:Name="PolicyCard" Background="{StaticResource ElevBrush}" CornerRadius="17" Padding="19" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,0,18">
                        <Border.RenderTransform>
                            <TranslateTransform/>
                        </Border.RenderTransform>
                        <StackPanel Spacing="15">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="PolicyTitleText" FontSize="19" FontWeight="Medium" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="PolicyBodyText" FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <!-- Grid host (no rounded clip) + background Border behind the thumb -->
                                <Grid x:Name="PolicySegment" Grid.Column="1" VerticalAlignment="Top" Width="178" Height="34" Loaded="PolicySegmentLoaded">
                                    <Border Background="#0AFFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="17"/>
                                    <Grid Margin="4,0">
                                        <Border x:Name="PolicyThumb" Width="85" Height="26" CornerRadius="13" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="PolicyThumbX"/>
                                            </Border.RenderTransform>
                                        </Border>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="DirectButton" Grid.Column="0" Content="Direct" Click="SetDirect" Style="{StaticResource SegmentGhost}" Foreground="{StaticResource InkBrush}"/>
                                            <Button x:Name="ThroughButton" Grid.Column="1" Content="Through" Click="SetThrough" Style="{StaticResource SegmentGhost}"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                            <Border Background="#08FFFFFF" CornerRadius="10" Padding="13">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Local network directly" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock x:Name="LanBody" FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="LanSwitch" Grid.Column="1" Style="{StaticResource CompactSwitch}" Click="LanToggled"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="A domain is resolved on the regular network. An app's addresses are learned as it connects." FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="Nothing here yet. Add an IP, a domain, or an app." FontSize="14" x:Name="RulesEmpty" Visibility="Collapsed" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                            <StackPanel x:Name="Rules"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Add route" Style="{StaticResource PillButton}" Click="OpenRoutes"/>
                                <Button Content="Add app" Style="{StaticResource PillButton}" Click="AddApp"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="Overlay" Grid.ColumnSpan="2" Background="#96000000" Visibility="Collapsed">
            <Border x:Name="Sheet" MaxWidth="720" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource BgBrush}" CornerRadius="18" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="24,22" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="SheetScale" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Grid>
                    <StackPanel x:Name="SettingsPane" Visibility="Collapsed" Spacing="22" Width="520">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="1.4"/>
                                <Ellipse Width="4" Height="4" Fill="{StaticResource AccentBrush}" Margin="4,0,0,1" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Settings" FontSize="19" FontWeight="Medium" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Background="{StaticResource ElevBrush}" CornerRadius="14" Padding="16" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Open at login" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="Fairlead starts when you sign in. A default tunnel connects on its own." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="LoginSwitch" Grid.Column="1" Style="{StaticResource CompactSwitch}" Click="LoginToggled"/>
                                </Grid>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Start hidden" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="Open in the tray only. Click the Fairlead icon to show the window." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="HiddenSwitch" Grid.Column="1" Style="{StaticResource CompactSwitch}" Click="HiddenToggled"/>
                                </Grid>
                                <Border Height="1" Background="{StaticResource LineBrush}"/>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Default tunnel" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="Fairlead selects this tunnel when it opens and connects it." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                    <ComboBox x:Name="DefaultCombo" HorizontalAlignment="Stretch" SelectionChanged="DefaultChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource ElevBrush}" CornerRadius="14" Padding="16" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Components" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Ellipse x:Name="AwgDot" Width="6" Height="6" Fill="{StaticResource FaintBrush}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                    <TextBlock Grid.Column="1" Text="amneziawg-go" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextBrush}" VerticalAlignment="Top"/>
                                    <TextBlock x:Name="AwgLine" Grid.Column="2" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Top"/>
                                    <Ellipse x:Name="HelperRowDot" Grid.Row="1" Width="6" Height="6" Fill="{StaticResource FaintBrush}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Helper" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextBrush}" VerticalAlignment="Top"/>
                                    <TextBlock x:Name="HelperLine" Grid.Row="1" Grid.Column="2" Text="\\.\pipe\fairlead" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Top"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Config folder" Style="{StaticResource PillButton}" HorizontalAlignment="Left" Click="OpenFolder"/>
                                    <Button Grid.Column="1" Content="Start helper" Style="{StaticResource ProminentButton}" Click="StartHelper"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Button Content="Close" Style="{StaticResource PillButton}" HorizontalAlignment="Right" Click="CloseSheet"/>
                    </StackPanel>
                    <Grid x:Name="EditorPane" Visibility="Collapsed" Width="660" MinHeight="520">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Config" FontSize="19" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                            <Grid x:Name="EditorSegment" HorizontalAlignment="Right" VerticalAlignment="Center" Width="148" Height="34" Loaded="EditorSegmentLoaded">
                                <Border Background="#0AFFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="17"/>
                                <Grid Margin="4,0">
                                    <Border x:Name="EditorThumb" Width="70" Height="26" CornerRadius="13" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="EditorThumbX"/>
                                        </Border.RenderTransform>
                                    </Border>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="FieldsButton" Grid.Column="0" Content="Fields" Click="ShowFields" Style="{StaticResource SegmentGhost}" Foreground="{StaticResource InkBrush}"/>
                                        <Button x:Name="TextButton" Grid.Column="1" Content="Text" Click="ShowRaw" Style="{StaticResource SegmentGhost}"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                        <ScrollViewer x:Name="EditorScroll" Grid.Row="1" Margin="0,0,-16,16" Padding="0,0,16,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="EditorFields" Spacing="18"/>
                        </ScrollViewer>
                        <TextBox x:Name="RawConfig" Grid.Row="1" Margin="0,0,0,16" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Style="{StaticResource QuietBox}" Visibility="Collapsed" MinHeight="420"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Cancel" Style="{StaticResource PillButton}" HorizontalAlignment="Right" Click="CloseSheet"/>
                            <Button Content="Save" Style="{StaticResource ProminentButton}" HorizontalAlignment="Right" Click="SaveEditor"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="RoutePane" Visibility="Collapsed" Width="440" Spacing="16">
                        <TextBlock Text="Add route" FontSize="19" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="One address or domain per line." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                        <TextBox x:Name="RouteName" PlaceholderText="Name" Style="{StaticResource QuietBox}" TextChanged="RouteChanged"/>
                        <Grid>
                            <TextBox x:Name="RouteBox" AcceptsReturn="True" Height="180" TextWrapping="Wrap" FontFamily="Consolas" Style="{StaticResource QuietBox}" TextChanged="RouteChanged"/>
                            <TextBlock x:Name="RouteHint" IsHitTestVisible="False" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource FaintBrush}" Margin="12,10,12,0" Text="example.com&#x0a;203.0.113.10&#x0a;10.1.0.0/16"/>
                        </Grid>
                        <TextBlock x:Name="RouteError" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <Grid>
                            <TextBlock x:Name="RouteProgress" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedBrush}" Visibility="Collapsed"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Button Content="Cancel" Style="{StaticResource PillButton}" Click="CloseSheet"/>
                                <Button x:Name="RouteAdd" Content="Add" Style="{StaticResource ProminentButton}" Click="SaveRoutes" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="ListPane" Visibility="Collapsed" Width="480" Spacing="12">
                        <TextBlock x:Name="ListTitle" FontSize="19" FontWeight="Medium" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                        <TextBox x:Name="ListName" PlaceholderText="Name" Style="{StaticResource QuietBox}" TextChanged="ListChanged"/>
                        <TextBlock x:Name="ListHint" Text="One address or domain per line." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                        <TextBox x:Name="ListEntries" AcceptsReturn="True" Height="180" TextWrapping="Wrap" FontFamily="Consolas" Style="{StaticResource QuietBox}" TextChanged="ListChanged" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        <StackPanel x:Name="ListResolvedPane" Spacing="6" Visibility="Collapsed">
                            <TextBlock Text="Resolved" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource FaintBrush}"/>
                            <TextBox x:Name="ListResolved" IsReadOnly="True" AcceptsReturn="True" Height="120" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Style="{StaticResource QuietBox}" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                        <TextBlock x:Name="ListError" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <Grid>
                            <TextBlock x:Name="ListProgress" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedBrush}" Visibility="Collapsed"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Button x:Name="ListClose" Content="Close" Style="{StaticResource PillButton}" Click="CloseSheet"/>
                                <Button x:Name="ListCancel" Content="Cancel" Style="{StaticResource PillButton}" Click="CloseSheet" Visibility="Collapsed"/>
                                <Button x:Name="ListSave" Content="Save" Style="{StaticResource ProminentButton}" Click="SaveList" Visibility="Collapsed" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="ConfirmPane" Visibility="Collapsed" Width="380" Spacing="16">
                        <TextBlock x:Name="ConfirmText" FontSize="16" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Cancel" Style="{StaticResource PillButton}" Click="CloseSheet"/>
                            <Button Content="Delete" Style="{StaticResource ProminentButton}" Click="ConfirmDelete"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid x:Name="AppPane" Visibility="Collapsed" Width="480" Height="520">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Add app" FontSize="19" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                        <TextBox x:Name="AppSearch" Grid.Row="1" Margin="0,12,0,10" PlaceholderText="Search" Style="{StaticResource QuietBox}" TextChanged="AppSearchChanged"/>
                        <ListView x:Name="AppList" Grid.Row="2" SelectionMode="Single" Background="Transparent" BorderThickness="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                        <TextBlock x:Name="AppStatus" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <Button Content="Browse…" Style="{StaticResource PillButton}" HorizontalAlignment="Left" Click="BrowseApp"/>
                            <Button Content="Close" Style="{StaticResource PillButton}" HorizontalAlignment="Right" Click="CloseSheet"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <!-- Rune-style custom titlebar: brand + live phase + settings; caption buttons drawn by the system over the trailing edge. -->
        <Grid x:Name="DragRegion" Grid.ColumnSpan="2" Height="40" VerticalAlignment="Top" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="14,0,0,0">
                <Grid Width="14" Height="14" VerticalAlignment="Center">
                    <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="1.3"/>
                    <Ellipse x:Name="TitlePhaseDot" Width="3.5" Height="3.5" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="FAIRLEAD" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{StaticResource TextBrush}"/>
                <Border x:Name="TitlePhase" Visibility="Collapsed" Padding="8,3" CornerRadius="10" Background="#1A7CDBB6" VerticalAlignment="Center">
                    <TextBlock x:Name="TitlePhaseText" FontSize="11" FontWeight="Medium" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,140,0">
                <Ellipse x:Name="HelperDot" Width="7" Height="7" Fill="{StaticResource FaintBrush}" VerticalAlignment="Center"
                         ToolTipService.ToolTip="Helper is not running"/>
                <Button Width="34" Height="28" MinWidth="0" MinHeight="0" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="8" Click="OpenSettings" ToolTipService.ToolTip="Settings" VerticalAlignment="Center">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
