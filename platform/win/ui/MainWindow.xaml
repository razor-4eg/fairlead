<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Fairlead.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fairlead"
    Title="Fairlead">
        <Grid x:Name="Root" Background="{StaticResource BgBrush}" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="10" IsStaggeringEnabled="False"/>
            </TransitionCollection>
        </Grid.Transitions>

        <Grid Grid.Column="0" Background="{StaticResource SideBrush}" Padding="14,48,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="16" Height="16" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.4" VerticalAlignment="Center"/>
                <Ellipse Width="4" Height="4" Fill="{StaticResource AccentBrush}" Margin="8,0,0,2" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="FAIRLEAD" Margin="10,0,8,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{StaticResource TextBrush}"/>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="OpenSettings" ToolTipService.ToolTip="Settings">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </Grid>
            <Grid Grid.Row="1" Margin="0,16,0,0">
            <TextBox x:Name="Search" PlaceholderText="Search" Style="{StaticResource QuietBox}" Padding="32,8,10,8" TextChanged="SearchChanged">
                <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="#0AFFFFFF"/>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#12FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0AFFFFFF"/>
                </TextBox.Resources>
            </TextBox>
            <FontIcon Glyph="&#xE721;" FontSize="12" Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
            </Grid>
            <TextBlock Grid.Row="2" Text="TUNNELS" Margin="4,22,0,8" FontSize="10" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{StaticResource FaintBrush}"/>
            <ListView x:Name="TunnelList" Grid.Row="3" SelectionChanged="TunnelChosen" Background="Transparent" BorderThickness="0" Padding="0">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:Tunnel">
                        <Grid Padding="10,8" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="7" Height="7" Fill="{x:Bind StatusBrush, Mode=OneWay}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind Name}" FontSize="13" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind Endpoint}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="UseSystemFocusVisuals" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Grid>
                                        <Border x:Name="Plate" CornerRadius="9" Background="Transparent"/>
                                        <ContentPresenter/>
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal"/>
                                                <VisualState x:Name="PointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Target="Plate.Background" Value="#09FFFFFF"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Pressed"/>
                                                <VisualState x:Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Target="Plate.Background" Value="#12FFFFFF"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="PointerOverSelected">
                                                    <VisualState.Setters>
                                                        <Setter Target="Plate.Background" Value="#18FFFFFF"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="PressedSelected">
                                                    <VisualState.Setters>
                                                        <Setter Target="Plate.Background" Value="#18FFFFFF"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
            <StackPanel Grid.Row="4" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse x:Name="HelperDot" Width="6" Height="6" Fill="{StaticResource FaintBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind Session.HelperText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource PillButton}" Click="NewTunnel">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" TextLineBounds="Tight"/>
                            <TextBlock Text="New" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PillButton}" Click="ImportTunnel">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8B5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" TextLineBounds="Tight"/>
                            <TextBlock Text="Import" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1">
            <StackPanel x:Name="Empty" Visibility="{x:Bind local:Vis.Hide(Session.HasTunnel), Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" MaxWidth="460">
                <Ellipse Width="42" Height="42" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" HorizontalAlignment="Center"/>
                <TextBlock Text="No tunnels" FontSize="22" FontWeight="Medium" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Import a WireGuard or AmneziaWG config, or create a new one. You can drop a .conf file or an Amnezia share on the window." FontSize="13" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                <Button Content="Create" Style="{StaticResource ProminentButton}" HorizontalAlignment="Center" Click="NewTunnel"/>
            </StackPanel>
            <ScrollViewer x:Name="Detail" Visibility="{x:Bind local:Vis.Show(Session.HasTunnel), Mode=OneWay}" Padding="32,56,32,36" HorizontalScrollBarVisibility="Disabled">
                <StackPanel HorizontalAlignment="Stretch" Spacing="26">
                        <Border Visibility="{x:Bind local:Vis.Show(Session.HasNotice), Mode=OneWay}" Background="{StaticResource ElevBrush}" CornerRadius="16" Padding="14,10" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <TextBlock Text="{x:Bind Session.Notice, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                    </Border>
                    <Border x:Name="Banner" Visibility="Collapsed" Background="{StaticResource ElevBrush}" CornerRadius="16" Padding="14,10" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1">
                        <TextBlock x:Name="BannerText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Session.Title, Mode=OneWay}" FontSize="28" FontWeight="Medium" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="1" Text="{x:Bind Session.Endpoint, Mode=OneWay}" FontSize="13" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="2" Text="{x:Bind Session.Address, Mode=OneWay}" FontSize="12" FontFamily="Consolas" Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Column="1" Grid.RowSpan="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Height="24" Padding="10,0" VerticalAlignment="Center" Visibility="{x:Bind local:Vis.Show(Session.Amnezia), Mode=OneWay}" Background="#1F7CDBB6" CornerRadius="12" BorderBrush="#477CDBB6" BorderThickness="1">
                                <TextBlock Text="AmneziaWG" FontSize="11" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" TextLineBounds="Tight" Margin="0,1,0,0"/>
                            </Border>
                            <Button Content="Edit" Style="{StaticResource PillButton}" Click="OpenEditor" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource IconButton}" Background="#0DFFFFFF" VerticalAlignment="Center">
                                <Button.Content>
                                    <TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button.Content>
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Export…" Click="ExportSelected"/>
                                        <MenuFlyoutItem Text="Delete" Click="AskDelete"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        </Grid>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="22">
                        <Button x:Name="Power" Width="92" Height="92" Padding="0" Background="#081214" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="46" Click="TogglePower">
                            <FontIcon Glyph="&#xE7E8;" FontSize="26" Foreground="{StaticResource MutedBrush}"/>
                        </Button>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{x:Bind Session.Phase, Mode=OneWay}" FontSize="22" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="{x:Bind Session.Detail, Mode=OneWay}" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{x:Bind Session.IfaceLine, Mode=OneWay}" FontSize="12" FontFamily="Consolas" Foreground="{StaticResource FaintBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}" Grid.Column="0"><StackPanel><TextBlock Text="DOWN" Style="{StaticResource StatLabel}"/><TextBlock Text="{x:Bind Session.Down, Mode=OneWay}" Style="{StaticResource StatValue}"/></StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}" Grid.Column="1"><StackPanel><TextBlock Text="UP" Style="{StaticResource StatLabel}"/><TextBlock Text="{x:Bind Session.Up, Mode=OneWay}" Style="{StaticResource StatValue}"/></StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}" Grid.Column="2"><StackPanel><TextBlock Text="RECEIVED" Style="{StaticResource StatLabel}"/><TextBlock Text="{x:Bind Session.Rx, Mode=OneWay}" Style="{StaticResource StatValue}"/></StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}" Grid.Column="3"><StackPanel><TextBlock Text="SENT" Style="{StaticResource StatLabel}"/><TextBlock Text="{x:Bind Session.Tx, Mode=OneWay}" Style="{StaticResource StatValue}"/></StackPanel></Border>
                    </Grid>
                    <Border Background="{StaticResource ElevBrush}" CornerRadius="16" Padding="18" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <StackPanel Spacing="14">
                            <Grid RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Session.PolicyTitle, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" VerticalAlignment="Center" Background="#10FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="3">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="DirectButton" Content="Direct" Click="SetDirect" Style="{StaticResource SegmentOn}"/>
                                            <Button x:Name="ThroughButton" Content="Through" Click="SetThrough" Style="{StaticResource SegmentOff}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{x:Bind Session.PolicyBody, Mode=OneWay}" FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </Grid>
                            <Border Background="#08FFFFFF" CornerRadius="10" Padding="12,10">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Local network directly" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="{x:Bind Session.LanText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="LanSwitch" Grid.Column="1" Style="{StaticResource CompactSwitch}" Click="LanToggled"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="A domain is resolved on the regular network. An app's addresses are learned as it connects." FontSize="12" Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="Nothing here yet. Add an IP, a domain, or an app." Visibility="{x:Bind local:Vis.Show(Session.RulesEmpty), Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/>
                            <StackPanel x:Name="Rules"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Add route" Style="{StaticResource PillButton}" Click="OpenRoutes"/>
                                <Button Content="Add app" Style="{StaticResource PillButton}" Click="AddApp"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="Overlay" Grid.ColumnSpan="2" Background="#96000000" Visibility="Collapsed">
            <Border x:Name="Sheet" MaxWidth="720" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource BgBrush}" CornerRadius="18" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="24" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="SheetScale" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Grid>
                    <StackPanel x:Name="SettingsPane" Visibility="Collapsed" Spacing="16" Width="520">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" TextLineBounds="Tight"/>
                            <TextBlock Text="Settings" FontSize="26" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                        <Border Background="{StaticResource ElevBrush}" CornerRadius="16" Padding="16" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Open at login" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="Fairlead starts when you sign in. A default tunnel connects on its own." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="LoginSwitch" Grid.Column="1" Style="{StaticResource CompactSwitch}" Click="LoginToggled"/>
                                </Grid>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Default tunnel" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="Fairlead selects this tunnel when it opens and connects it." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox x:Name="DefaultCombo" HorizontalAlignment="Stretch" SelectionChanged="DefaultChanged"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource ElevBrush}" CornerRadius="16" Padding="16" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Components" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Ellipse x:Name="AwgDot" Width="6" Height="6" Fill="{StaticResource FaintBrush}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                    <TextBlock Grid.Column="1" Text="amneziawg-go" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextBrush}" VerticalAlignment="Top"/>
                                    <TextBlock x:Name="AwgLine" Grid.Column="2" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Top"/>
                                    <Ellipse x:Name="HelperRowDot" Grid.Row="1" Width="6" Height="6" Fill="{StaticResource FaintBrush}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Helper" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextBrush}" VerticalAlignment="Top"/>
                                    <TextBlock x:Name="HelperLine" Grid.Row="1" Grid.Column="2" Text="\\.\pipe\fairlead" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Top"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Button Content="Config folder" Style="{StaticResource PillButton}" HorizontalAlignment="Left" Click="OpenFolder"/>
                                    <Button Content="Start helper" Style="{StaticResource ProminentButton}" HorizontalAlignment="Right" Click="StartHelper"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Button Content="Close" Style="{StaticResource PillButton}" HorizontalAlignment="Right" Click="CloseSheet"/>
                    </StackPanel>
                    <Grid x:Name="EditorPane" Visibility="Collapsed" Width="660">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Config" FontSize="26" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#10FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="FieldsButton" Content="Fields" Click="ShowFields" Style="{StaticResource SegmentOn}"/>
                                    <Button x:Name="TextButton" Content="Text" Click="ShowRaw" Style="{StaticResource SegmentOff}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ScrollViewer Grid.Row="1" Margin="0,16,-16,16" Padding="0,0,16,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="EditorFields" Spacing="10"/>
                        </ScrollViewer>
                        <TextBox x:Name="RawConfig" Grid.Row="1" Margin="0,16,0,16" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Style="{StaticResource QuietBox}" Visibility="Collapsed" MinHeight="420"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Cancel" Style="{StaticResource PillButton}" Click="CloseSheet"/>
                            <Button Content="Save" Style="{StaticResource ProminentButton}" Click="SaveEditor"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="RoutePane" Visibility="Collapsed" Width="480" Spacing="12">
                        <TextBlock Text="Add route" FontSize="26" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="One address or domain per line." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                        <TextBox x:Name="RouteName" PlaceholderText="Name" Style="{StaticResource QuietBox}" TextChanged="RouteChanged"/>
                        <Grid>
                            <TextBox x:Name="RouteBox" AcceptsReturn="True" Height="180" TextWrapping="Wrap" FontFamily="Consolas" Style="{StaticResource QuietBox}" TextChanged="RouteChanged"/>
                            <TextBlock x:Name="RouteHint" IsHitTestVisible="False" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource FaintBrush}" Margin="12,10,12,0" Text="example.com&#x0a;203.0.113.10&#x0a;10.1.0.0/16"/>
                        </Grid>
                        <TextBlock x:Name="RouteError" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <Grid>
                            <TextBlock x:Name="RouteProgress" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedBrush}" Visibility="Collapsed"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Button Content="Cancel" Style="{StaticResource PillButton}" Click="CloseSheet"/>
                                <Button x:Name="RouteAdd" Content="Add" Style="{StaticResource ProminentButton}" Click="SaveRoutes" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="ListPane" Visibility="Collapsed" Width="480" Spacing="12">
                        <TextBlock x:Name="ListTitle" FontSize="26" FontWeight="Medium" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                        <TextBox x:Name="ListBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Height="360" Style="{StaticResource QuietBox}" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        <Button Content="Close" Style="{StaticResource PillButton}" HorizontalAlignment="Right" Click="CloseSheet"/>
                    </StackPanel>
                    <StackPanel x:Name="ConfirmPane" Visibility="Collapsed" Width="380" Spacing="16">
                        <TextBlock x:Name="ConfirmText" FontSize="16" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Cancel" Style="{StaticResource PillButton}" Click="CloseSheet"/>
                            <Button Content="Delete" Style="{StaticResource ProminentButton}" Click="ConfirmDelete"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="DragRegion" Grid.ColumnSpan="2" Height="32" VerticalAlignment="Top" Background="Transparent"/>
    </Grid>
</Window>
