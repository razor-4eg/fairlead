<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.1.1</Version>
    <FileVersion>1.1.1.0</FileVersion>
    <InformationalVersion>1.1.1</InformationalVersion>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Fairlead</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <ApplicationIcon>Assets\Fairlead.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en;ru;de;es;fr;pt;zh-Hans;zh-Hant</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.251106002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.2" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\Fairlead.ico" CopyToOutputDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>
  <Target Name="TrimFairleadSdkPayload" AfterTargets="ExtractMicrosoftWindowsAppSDKMsixFiles">
    <ItemGroup>
      <_FlDropMui Include="$(MicrosoftWindowsAppSDKMsixContent)\**\*.mui" />
      <_FlDropMui Remove="$(MicrosoftWindowsAppSDKMsixContent)\en-us\**\*.mui" />
      <_FlDropMui Remove="$(MicrosoftWindowsAppSDKMsixContent)\en-GB\**\*.mui" />
      <_FlDropMui Remove="$(MicrosoftWindowsAppSDKMsixContent)\ru-RU\**\*.mui" />
      <_FlDropMui Remove="$(MicrosoftWindowsAppSDKMsixContent)\de-DE\**\*.mui" />
      <_FlDropMui Remove="$(MicrosoftWindowsAppSDKMsixContent)\es-ES\**\*.mui" />
      <_FlDropMui Remove="$(MicrosoftWindowsAppSDKMsixContent)\es-MX\**\*.mui" />
      <_FlDropMui Remove="$(MicrosoftWindowsAppSDKMsixContent)\fr-FR\**\*.mui" />
      <_FlDropMui Remove="$(MicrosoftWindowsAppSDKMsixContent)\fr-CA\**\*.mui" />
      <_FlDropMui Remove="$(MicrosoftWindowsAppSDKMsixContent)\pt-BR\**\*.mui" />
      <_FlDropMui Remove="$(MicrosoftWindowsAppSDKMsixContent)\pt-PT\**\*.mui" />
      <_FlDropMui Remove="$(MicrosoftWindowsAppSDKMsixContent)\zh-CN\**\*.mui" />
      <_FlDropMui Remove="$(MicrosoftWindowsAppSDKMsixContent)\zh-TW\**\*.mui" />
      <MicrosoftWindowsAppSDKFilesExcluded Include="@(_FlDropMui)" />
      <MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\workloads*.json" />
      <MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\Microsoft.Windows.AI*.dll" />
      <MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\Microsoft.Windows.AI*.winmd" />
      <MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\Microsoft.Windows.Workloads*" />
      <MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\Microsoft.Windows.Private.Workloads*" />
      <MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\onnxruntime*.dll" />
      <MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\DirectML.dll" />
      <MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\NpuDetect\**\*" />
      <MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\RestartAgent.exe" />
      <MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\WindowsAppRuntime.png" />
      <MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\map.html" />
    </ItemGroup>
  </Target>
  <Target Name="TrimFairleadPublish" AfterTargets="Publish">
    <ItemGroup>
      <_FlPublishJunk Include="$(PublishDir)createdump.exe" />
      <_FlPublishJunk Include="$(PublishDir)Fairlead.pdb" />
      <_FlPublishJunk Include="$(PublishDir)Microsoft.Windows.AI.*.dll" />
      <_FlPublishJunk Include="$(PublishDir)Microsoft.ML.OnnxRuntime.dll" />
    </ItemGroup>
    <Delete Files="@(_FlPublishJunk)" />
  </Target>
</Project>
